{
  "framework": "vite",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/generate-ticket.ts": { "maxDuration": 30 },
    "api/on-registration.ts": { "maxDuration": 30 },
    "api/setup-storage.ts": { "maxDuration": 30 },
    "api/generate-certificate.ts": { "maxDuration": 30 },
    "api/reachout.ts": { "maxDuration": 60 },
    "api/end-event.ts": { "maxDuration": 60 },
    "api/notify-org-decision.ts": { "maxDuration": 30 },
    "api/mc-pending-requests.ts": { "maxDuration": 15 },
    "api/complete-signup.ts": { "maxDuration": 30 },
    "api/resend-verification.ts": { "maxDuration": 30 }
  }
}
