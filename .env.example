# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Payment Gateway (Razorpay)
# RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET are set in Vercel Environment Variables
# VITE_RAZORPAY_KEY_ID is exposed to the client for Razorpay Checkout
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
# Add in Vercel dashboard → Settings → Environment Variables:
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=your_secret_key

# EmailJS (for registration confirmation emails)
# 1. Sign up at https://www.emailjs.com/ (free: 200 emails/month)
# 2. Create an Email Service (Gmail, Outlook, etc.)
# 3. Create an Email Template with these variables:
#    {{to_name}} {{to_email}} {{event_title}} {{event_date}}
#    {{event_time}} {{event_venue}} {{ticket_type}} {{quantity}}
#    {{qr_code_url}} {{event_url}}
# 4. Copy the Service ID, Template ID, and Public Key below
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Groq API Key (for AI-powered document parsing)
VITE_GROQ_API_KEY=gsk_your_api_key_here
