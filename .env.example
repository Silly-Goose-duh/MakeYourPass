# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Payment Gateway (Razorpay)
# RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET are set in Vercel Environment Variables
# VITE_RAZORPAY_KEY_ID is exposed to the client for Razorpay Checkout
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
# Add in Vercel dashboard → Settings → Environment Variables:
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=your_secret_key

# EmailJS (for registration confirmation emails)
# 1. Sign up at https://www.emailjs.com/ (free: 200 emails/month)
# 2. Create an Email Service (Gmail, Outlook, etc.)
# 3. Create an Email Template with these variables:
#    {{to_name}} {{to_email}} {{event_title}} {{event_date}}
#    {{event_time}} {{event_venue}} {{ticket_type}} {{quantity}}
#    {{qr_code_url}} {{event_url}}
# 4. Copy the Service ID, Template ID, and Public Key below
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# AI document parsing (Groq) — SERVER-SIDE ONLY
# The Groq API key is read by /api/poster-theme (action: 'chat'), a serverless
# function. It must NEVER be exposed to the browser: anything prefixed VITE_
# is inlined into the JS bundle by Vite and is readable by anyone who opens
# devtools.
# Set this in Vercel → Settings → Environment Variables (and keep it un-prefixed):
#   GROQ_API_KEY=gsk_your_api_key_here
# The browser reaches Groq through the authenticated /api/groq proxy instead.
#
# DEPRECATED / DO NOT SET: VITE_GROQ_API_KEY
#   The key used to be shipped to the client this way. If you still have this
#   variable defined locally or in Vercel, DELETE it and rotate the Groq key.
# GROQ_API_KEY=gsk_your_api_key_here

# Addresses auto-granted platform superadmin (/mc) on signup.
# Comma-separated, case-insensitive. This list acts as a shared secret while
# Supabase email confirmation is OFF — anyone who can register with a listed
# address gets full platform admin. Keep it in the environment, not in source,
# and turn email confirmation on in Supabase.
SUPERADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Security hardening (added by the Phase 1-4 audit)
# All of these are SERVER env vars — set them in Vercel → Settings →
# Environment Variables. None of them may use the VITE_ prefix.
# ---------------------------------------------------------------------------

# Public origin of the deployed app, e.g. https://makeyourpass.vercel.app
# Used to lock CORS down to your own site. Previously every endpoint replied
# with `Access-Control-Allow-Origin: *`, which let any website on the internet
# drive the unauthenticated endpoints from a visitor's browser.
# If unset, the handlers fall back to the incoming request host.
APP_ORIGIN=https://makeyourpass.vercel.app

# Shared rate-limit store. Strongly recommended: without it the limiter falls
# back to an in-process Map, which is per-lambda-instance and therefore weak
# against a distributed flood.
# Create a free Redis database at https://console.upstash.com and paste both
# values here.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# Timezone used by the T-24h reminder cron to decide what "tomorrow" means.
# The cron previously used Date.UTC(), which computes the wrong calendar day
# for IST users and sent reminders on the wrong date.
EVENT_TIMEZONE=Asia/Kolkata

# Shared secret for server-to-server calls between our own functions.
#
# REQUIRED for the anonymous registration funnel to work end-to-end:
# a student registers on the public form without an account, so /api/on-registration
# calls /api/generate-ticket on their behalf. Because ticket generation is now
# authenticated, that internal hop must present this secret. Without it the
# confirmation email still goes out, but the ticket PNG is NOT attached and the
# response carries ticket_error.
#
# Falls back to CRON_SECRET, then SETUP_SECRET, if unset — but set it
# explicitly to a long random value (e.g. `openssl rand -hex 32`).
INTERNAL_API_SECRET=

# Protects the T-24h reminder cron when it is invoked manually.
CRON_SECRET=

# Admin helper that used to guard /api/setup-storage. That endpoint has been
# DELETED — the storage policies now ship as SQL (supabase/migrations/).
# Remove this variable from Vercel once you have rotated it.
# SETUP_SECRET=

